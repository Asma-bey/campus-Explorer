<?xml version="1.0" encoding="utf-8"?>
<!-- Un parcours enregistre (.history-card) : carte noire, pastille jaune, date, duree, distance -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="13dp"
    android:background="@drawable/bg_round7"
    android:backgroundTint="@color/black"
    android:gravity="center_vertical"
    android:minHeight="98dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_round5"
        android:backgroundTint="@color/yellow">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_route"
            app:tint="@color/black" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/session_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/history_small"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_bold"
            android:text="@string/session_title"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clock"
                app:tint="@color/tracking_label" />

            <TextView
                android:id="@+id/session_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/tracking_label"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_route"
                app:tint="@color/tracking_label" />

            <TextView
                android:id="@+id/session_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/tracking_label"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
