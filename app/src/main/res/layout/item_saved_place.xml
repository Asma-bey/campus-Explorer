<?xml version="1.0" encoding="utf-8"?>
<!-- Un lieu enregistre (.saved-list article) : pastille, textes, corbeille -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card7"
    android:gravity="center_vertical"
    android:minHeight="92dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/saved_icon_box"
        android:layout_width="46dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_round5">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pin"
            app:tint="@color/black" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/saved_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/saved_category"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/saved_name"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="9dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/saved_see_on_map"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow"
                app:tint="@color/black" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/saved_remove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_outline"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_trash"
        app:tint="@color/muted" />
</LinearLayout>
