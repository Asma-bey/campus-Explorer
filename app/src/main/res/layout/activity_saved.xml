<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecran 3 : lieux enregistres et historique des parcours (SavedScreen de la maquette).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".SavedActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/paper_saved"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== en-tete blanc avec les deux ronds (.saved-header, .header-shape) ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@color/white"
                android:clipChildren="true">

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="125dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-37dp"
                    android:layout_marginBottom="-43dp">

                    <View
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:layout_gravity="end"
                        android:background="@drawable/bg_oval"
                        android:backgroundTint="@color/yellow" />

                    <View
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_oval"
                        android:backgroundTint="@color/cyan" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="22dp">

                    <include layout="@layout/view_logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="9dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_slashes"
                            app:tint="@color/yellow" />

                        <TextView
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/saved_title"
                            android:textSize="36sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="27dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/saved_subtitle" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== contenu (.saved-content) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="19dp"
                android:paddingTop="24dp"
                android:paddingEnd="19dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/saved_places"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/saved_count"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2 lieux" />
                </LinearLayout>

                <!-- lieux enregistres, remplis par SavedActivity (item_saved_place.xml) -->
                <LinearLayout
                    android:id="@+id/saved_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical" />

                <!-- etat vide (.empty-state) -->
                <LinearLayout
                    android:id="@+id/empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_empty_state"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="25dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="25dp"
                    android:paddingBottom="30dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_oval"
                        android:backgroundTint="@color/empty_icon_bg">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bookmark"
                            app:tint="@color/black" />
                    </FrameLayout>

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/saved_empty_title"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="15dp"
                        android:gravity="center"
                        android:maxWidth="260dp"
                        android:text="@string/saved_empty_text" />

                    <TextView
                        android:id="@+id/btn_empty_explore"
                        style="@style/Text.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_round4"
                        android:backgroundTint="@color/black"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/saved_explore"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="29dp"
                    android:text="@string/saved_history"
                    android:textSize="19sp" />

                <!-- parcours enregistres en base SQLite, remplis par SavedActivity (item_session.xml) -->
                <LinearLayout
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/history_empty"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/saved_history_empty"
                    android:visibility="gone" />

                <!-- bandeau vert affiche pendant un suivi (.active-session) -->
                <LinearLayout
                    android:id="@+id/active_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_session"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_oval"
                        android:backgroundTint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="@string/session_active_title"
                            android:textColor="@color/session_title"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/session_active_text"
                            android:textColor="@color/session_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
