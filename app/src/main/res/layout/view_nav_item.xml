<?xml version="1.0" encoding="utf-8"?>
<!--
    Un onglet de la barre du bas. L'icone et le texte sont remplis par BottomNav.java.
    duplicateParentState : quand l'onglet est "selected", ses enfants le sont aussi,
    et les selecteurs de couleur (color/nav_item, bg_nav_indicator) passent au noir et au jaune.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="38dp"
        android:layout_height="3dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_nav_indicator"
        android:duplicateParentState="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            app:tint="@color/nav_item" />

        <TextView
            android:id="@+id/nav_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/nav_item"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
