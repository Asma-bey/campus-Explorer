<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecran 1 : Accueil (HomeScreen de la maquette).
    Haut jaune (hero) + contenu blanc defilant, et la barre de navigation fixe en bas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- ===== hero jaune (.home-hero), 449dp de haut, le contenu qui deborde est coupe ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:background="@color/yellow"
                android:clipChildren="true">

                <!-- orbite : 3 cercles, un point cyan et une epingle, a moitie hors de l'ecran a droite -->
                <FrameLayout
                    android:layout_width="226dp"
                    android:layout_height="226dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="86dp"
                    android:layout_marginEnd="-102dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_ring" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="28dp"
                        android:background="@drawable/bg_ring" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="60dp"
                        android:background="@drawable/bg_ring_inner" />

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="27dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_oval"
                        android:backgroundTint="@color/cyan" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="90dp"
                        android:layout_marginTop="91dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/black" />
                </FrameLayout>

                <!-- la courbe blanche qui ferme le hero (.hero-curve) : une ellipse dont on ne voit que le haut -->
                <View
                    android:layout_width="480dp"
                    android:layout_height="110dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-42dp"
                    android:layout_marginBottom="-72dp"
                    android:background="@drawable/bg_oval" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include layout="@layout/view_logo" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_badge"
                            android:fontFamily="@font/inter_extrabold"
                            android:gravity="center"
                            android:letterSpacing="0.13"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/home_badge"
                            android:textColor="@color/black"
                            android:textSize="7sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="21dp"
                        android:layout_marginTop="44dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_slashes"
                        app:tint="@color/green" />

                    <TextView
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/home_title"
                        android:textSize="43sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/hero_text"
                        android:textSize="14sp" />

                    <!-- bouton principal noir avec l'ombre cyan (.primary-button) -->
                    <LinearLayout
                        android:id="@+id/btn_explore"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="23dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_map"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/Text.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/home_explore"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ===== contenu (.home-content) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_slashes"
                        app:tint="@color/cyan" />

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:text="@string/home_question" />
                </LinearLayout>

                <!-- grille 2 x 2 des categories, remplie par MainActivity (item_category.xml) -->
                <GridLayout
                    android:id="@+id/category_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_slashes"
                        app:tint="@color/yellow" />

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:text="@string/home_discover" />

                    <TextView
                        android:id="@+id/btn_see_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/inter_bold"
                        android:padding="6dp"
                        android:text="@string/home_see_all"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- les 3 premiers lieux, remplis par MainActivity (item_discovery.xml) -->
                <LinearLayout
                    android:id="@+id/discovery_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- .outline-button -->
                <LinearLayout
                    android:id="@+id/btn_saved"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bookmark"
                        app:tint="@color/black" />

                    <TextView
                        style="@style/Text.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="@string/home_saved" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
