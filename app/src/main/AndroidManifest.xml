<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- tuiles OpenStreetMap -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- position : demandees a l'execution, seulement quand l'utilisateur en a besoin -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- service au premier plan de type "location" (Android 9+ et Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- notification du suivi, Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- le GPS est utile mais pas obligatoire : l'appli s'installe aussi sans -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusExplorer">

        <!-- Ecran 1 : accueil, point d'entree -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CampusExplorer.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ecran 2 : carte. adjustPan : le clavier de la recherche ne compresse pas la carte -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Ecran 3 : lieux enregistres et historique -->
        <activity
            android:name=".SavedActivity"
            android:exported="false" />

        <!-- Suivi du parcours, au premier plan, de type location -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
